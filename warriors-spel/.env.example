# Kopiera denna fil till .env och fyll i din nyckel

# https://aistudio.google.com → Get API key (gratis nivå finns)
GEMINI_API_KEY=AIza...

# Bildläge:
#   bank (standard) = förgenererade bilder i public/scenes/ — gratis, se /setup.html
#   live            = generera varje scenbild via API:t — kräver betalnivå hos Google
# IMAGE_MODE=bank

# Valfritt — byt modeller eller port
# TEXT_MODEL=gemini-2.5-flash
# IMAGE_MODEL=gemini-3.1-flash-image
# PORT=3000
